# TODO: Const pointers and array types.
# TODO: imports and exports.
# TODO: utf-8 character literals etc.
# TODO: All operations and in nonReturnStatement. 
# TODO: vectors and matrices.
# TODO: slice array syntax

# ------------------------
# --- Compilation Unit ---
# ------------------------
compilationUnit ::= { importStatement } { declaration }

importStatement ::= CONST IDENTIFIER EQ AT_IMPORT LEFT_PAREN EXPRESSION RIGHT_PAREN SEMI

# -----------------
# --- Statement ---
# -----------------
blockStatement ::= [ UNSAFE ] LEFT_BRACE { statement } RIGHT_BRACE

breakStatement ::= BREAK SEMI

continueStatement ::= CONTINUE SEMI

deferStatement ::= DEFER blockStatement SEMI

emptyStatement ::= SEMI

expressionStatement ::= expression SEMI

returnStatement ::= RETURN expression SEMI

# ---------------------------
# --- Statement --- Loops ---
# ---------------------------
doLoop ::= DO blockStatement WHILE parExpression SEMI

forInit     ::= varDeclarator EQ expression { COMMA varDeclarator EQ expression }
forUpdate   ::= expression { COMMA expression }
forLoop     ::= FOR LEFT_PAREN [ forInit ] SEMI [ expression ] SEMI [ forUpdate ] RIGHT_PAREN blockStatement
forEachLoop ::= FOREACH LEFT_PAREN varDeclarator IN expression RIGHT_PAREN blockStatement

loopLoop ::= LOOP blockStatement

whileLoop ::= WHILE parExpression blockStatement

loopStatement ::= doLoop
                | forLoop
                | forEachLoop
                | loopLoop
                | whileLoop

# -----------------
# --- Statement ---
# -----------------
statement ::= breakStatement
            | continueStatement
            | emptyStatement
            | expressionStatement
            | loopStatement
            | returnStatement
            | varDecl 
            | typeDecl  

# ------------------
# --- Expression ---
# ------------------
functionCaptureGroup ::= LEFT_BRACKET { [ REF | EQ ] IDENTIFIER COMMA } [ REF | EQ ] IDENTIFIER RIGHT_BRACKET
functionReturn     ::= RETURN_ARROW ( nonAnonymousTypeExpression | NORETURN)

functionExpressionParameter  ::= [ ( VAR | CONST ) IDENTIFIER COLON ] nonAnonymousTypeExpression
functionExpressionParameters ::= functionExpressionParameter { COMMA functionExpressionParameter } [ COMMA ]
functionExpression ::= FN LEFT_PAREN [ functionExpressionParameters ] RIGHT_PAREN [ functionCaptureGroup ] functionReturn blockExpression

blockExpression ::= [ UNSAFE ] LEFT_BRACE { statement } [ expression ] RIGHT_BRACE

valueExpression ::= INT_LITERAL | FLOAT_LITERAL | STRING_LITERAL | CHAR_LITERAL | TRUE | FALSE | NULL | IDENTIFIER

ifExpression ::= IF parExpression blockExpression { ELSE IF parExpression blockExpression } [ ELSE blockExpression ]

parExpression ::= LEFT_PAREN expression RIGHT_PAREN

arrayInitExpression ::= LEFT_BRACKET [ expression { COMMA expression } ] RIGHT_BRACKET

structInitMember     ::= IDENTIFIER COLON expression
structInitEmpty      ::= IDENTIFIER LEFT_BRACE RIGHT_BRACE
structInitNonEmpty   ::= IDENTIFIER LEFT_BRACE structInitMember { COMMA structInitMember } [ COMMA ] RIGHT_BRACE
structInitExpression ::= structInitEmpty | structInitNonEmpty

tupleInitExpression ::= LESS expression { COMMA expression } [ COMMA ] GREATER

baseExpression (0) ::= blockExpression
                     | functionExpression
                     | valueExpression # base case of expression.
                     | ifExpression
                     | parExpression
                     | arrayInitExpression
                     | structInitExpression
                     | tupleInitExpression

addressExpression ::= postFixExpression DOT ( PTR_VAR | PTR_CONST )

dereferenceExpression ::= postFixExpression DOT STAR

functionCallParamList     ::= LEFT_PAREN [ expression { COMMA expression } ] [ COMMA ]  RIGHT_PAREN
functionCallExprNonInline ::= postFixExpression functionCallParamList
functionCallExprInline    ::= postFixExpression AT_INLINE functionCallParamList

fieldAccessExpression ::= postFixExpression DOT identifier

indexExpression ::= postFixExpression LEFT_BRACKET expression RIGHT_BRACKET

referenceExpression ::= postFixExpression DOT ( REF_VAR | REF_CONST )

scopeResolutionExpression ::= postFixExpression COLON_COLON identifier

postFixExpression (1) ::= addressExpression
                        | baseExpression
                        | dereferenceExpression
                        | functionCallExpression
                        | fieldAccessExpression
                        | indexExpression
                        | referenceExpression
                        | scopeResolutionExpression

alignExpression ::= AT_ALIGN_OF LEFT_PAREN unaryExpression [ COMMA ] RIGHT_PAREN

castExpression ::= AT_CAST LEFT_PAREN nonAnonymousTypeExpression COMMA expression [ COMMA ] RIGHT_PAREN

complementExpression ::= TILDE unaryExpression

negationExpression ::= MINUS unaryExpression

notExpression ::= BANG unaryExpression

sizeOfExpression ::= AT_SIZE_OF LEFT_PAREN unaryExpression [ COMMA ] RIGHT_PAREN

unaryExpression (2) ::= postFixExpression
                      | alignExpression
                      | complementExpression
                      | negationExpression
                      | notExpression
                      | sizeOfExpression

rangeExpression (3) ::= expression ( RANGE_LESS | RANGE_EQ ) expression

exponentExpression (4) ::= rangeExpression
                         | exponentExpression STAR_STAR rangeExpression

multiplicativeExpression (5) ::= exponentExpression
                               | multiplicativeExpression STAR exponentExpression
                               | multiplicativeExpression SLASH exponentExpression
                               | multiplicativeExpression PERCENT exponentExpression

additiveExpression (6) ::= multiplicativeExpression
                         | additiveExpression PLUS multiplicativeExpression 
                         | additiveExpression MINUS multiplicativeExpression

shiftExpression (7) ::= additiveExpression
                      | shiftExpression LEFT_SHIFT additiveExpression
                      | shiftExpression RIGHT_SHIFT additiveExpression

relationalExpression (8) ::= shiftExpression
                           | relationalExpression LESS shiftExpression
                           | relationalExpression LESS_EQ shiftExpression
                           | relationalExpression GREATER shiftExpression
                           | relationalExpression GREATER_EQ shiftExpression

equalityExpression (9) ::= relationalExpression
                         | equalityExpression EQ_EQ relationalExpression
                         | equalityExpression BANG_EQ relationalExpression

bitwiseAndExpression (10) ::= equalityExpression
                            | bitwiseAndExpression AMPERSAND equalityExpression

bitwiseXORExpression (11) ::= bitwiseAndExpression
                            | bitwiseXORExpression CARET bitwiseAndExpression

bitwiseOrExpression (12) ::= bitwiseXORExpression
                           | bitwiseOrExpression PIPE bitwiseXORExpression

logicalAndExpression (13) ::= bitwiseOrExpression
                            | logicalAndExpression AND bitwiseOrExpression

logicalOrExpression (14) ::= logicalAndExpression
                           | logicalOrExpression OR logicalAndExpression

assignmentExpression (15) ::= logicalOrExpression PLUS_EQ expression # All assignments return void.
                            | logicalOrExpression MINUS_EQ expression      
                            | logicalOrExpression STAR_EQ expression
                            | logicalOrExpression STAR_STAR_EQ expression
                            | logicalOrExpression SLASH_EQ expression
                            | logicalOrExpression PERCENT_EQ expression
                            | logicalOrExpression CARET_EQ expression   
                            | logicalOrExpression TILDE_EQ expression
                            | logicalOrExpression PIPE_EQ expression
                            | logicalOrExpression AMPERSAND_EQ expression
                            | logicalOrExpression LEFT_SHIFT_EQ  expression
                            | logicalOrExpression RIGHT_SHIFT_EQ expression
                            | logicalOrExpression EQ expression

expression ::= assignmentExpression

# -------------
# --- TYPES ---
# -------------
intrinsicTypeExpression ::= VOID
                          | BOOL
                          | F32 | F64
                          | U8 | I8 | U16 | I16 | U32 | I32 | U64 | I64
                          | CHAR8 | CHAR16 | CHAR32

alignmentDecl         ::= AT_ALIGN_AS LEFT_PAREN expression RIGHT_PAREN

enumTypeExpression ::= ENUM LEFT_BRACE RIGHT_BRACE

flagTypeExpression ::= unimplemented

structMember              ::= [ PUB ] identifier COLON nonAnonymousTypeExpression [ alignmentDecl ]
structTypeExpression      ::= ( STRUCT [ alignmentDecl ] LEFT_BRACE RIGHT_BRACE )
                            | ( STRUCT [ alignmentDecl ] LEFT_BRACE 
                                    structMember { COMMA structMember } [ COMMA ] 
                                RIGHT_BRACE )

# TODO: enumExpression and flagExpression
anonymousTypeExpression ::= enumTypeExpression
                          | flagTypeExpression
                          | structTypeExpression

functionTypeParameter  ::= [ IDENTIFIER COLON ] nonAnonymousTypeExpression
functionTypeParameters ::= functionTypeParameter { COMMA functionTypeParameter } [ COMMA ]
functionTypeExpression ::= FN LEFT_PAREN [ functionTypeParameters ] RIGHT_PAREN functionReturn

pointerTypeExpression ::= PTR [ VAR | CONST ] ( 
                            ( LEFT_PAREN functionTypeExpression RIGHT_PAREN ) | 
                            nonFunctionTypeExpression
                        )

arrayTypeExpression ::= LEFT_BRACKET [ expression ] RIGHT_BRACKET ( 
                            ( LEFT_PAREN functionTypeExpression RIGHT_PAREN ) | 
                            nonFunctionTypeExpression
                        )

referenceTypeExpression ::= REF [ VAR | CONST ] ( 
                            ( LEFT_PAREN functionTypeExpression RIGHT_PAREN ) | 
                            nonFunctionTypeExpression
                        )

tupleTypeExpression ::= LESS nonAnonymousTypeExpression { COMMA nonAnonymousTypeExpression } [ COMMA ] GREATER

nonFunctionTypeExpression ::= IDENTIFIER
                            | intrinsicTypeExpression 
                            | pointerTypeExpression
                            | arrayTypeExpression
                            | referenceTypeExpression
                            | tupleTypeExpression

nonAnonymousTypeExpression ::= nonFunctionTypeExpression | functionTypeExpression

typeExpression ::= nonAnonymousTypeExpression 
                 | anonymousTypeExpression


# -------------
# --- DECL ---
# -------------
mutability ::= CONST | VAR | COMPTIME

tupleDestructure ::= LEFT_PAREN IDENTIFIER { COMMA IDENTIFIER } [ COMMA ] RIGHT_PAREN

varDecl ::= [ PUB | PERSIST ] varDeclarator EQ ( expression | UNDEFINED ) SEMI
varDeclarator ::= mutability ( IDENTIFIER | tupleDestructure ) [ COLON nonAnonymousTypeExpression ]

typeDecl ::= [ PUB ] TYPE identifier EQ typeExpression SEMI

declaration ::= discardDecl
              | varDecl
              | typeDecl

discardDecl ::= UNDERSCORE EQ expression SEMI

# -------------
# --- MISC ---
# -------------
unimplemented ::= ""